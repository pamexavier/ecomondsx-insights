{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/server/index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "no_bundle": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ]
}
